{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/sandbox-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/report-billing-usage",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/passport-imports",
      "schedule": "30 4 * * *"
    }
  ]
}
