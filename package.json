{
  "name": "fydell-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "npm run build:sim && next build",
    "build:next": "next build",
    "build:sim": "esbuild js/sim/browser-entry.js --bundle --format=iife --outfile=sim-engine.js --platform=browser --target=es2018 --loader:.ts=ts --loader:.json=json",
    "build:sim:node": "esbuild js/sim/index.js --bundle --format=cjs --outfile=sim-engine.cjs --platform=node --target=node18 --loader:.ts=ts --loader:.json=json",
    "smoke:sim": "node scripts/smoke-meridian.js",
    "eval:session": "node scripts/eval-session.js",
    "accept:meridian": "node scripts/accept-meridian.mjs both",
    "accept:strong": "node scripts/accept-meridian.mjs strong",
    "accept:weak": "node scripts/accept-meridian.mjs weak",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:proof": "npm run test:proof:contracts && npm run test:sandbox:contracts && npm run test:proof:database && npm run test:golden-path-persistence",
    "test:proof:contracts": "tsx scripts/test-proof-graph.ts",
    "test:sandbox:contracts": "tsx scripts/test-sandbox-contracts.ts",
    "test:proof:live": "tsx scripts/test-sandbox-live.ts && tsx scripts/test-proof-database.ts && tsx --conditions react-server scripts/test-golden-path-persistence.ts",
    "test:proof:database": "tsx scripts/test-proof-database.ts",
    "test:golden-path-persistence": "tsx --conditions react-server scripts/test-golden-path-persistence.ts",
    "test:unit": "tsx scripts/test-pilot-validation.ts && tsx scripts/test-pilot-lifecycle.ts && tsx scripts/test-safe-next.ts && tsx scripts/test-state-machines.ts && tsx scripts/test-disclosure-boundary.ts && tsx scripts/test-wave1-contract.ts && tsx scripts/test-workspace-navigation.ts && tsx scripts/test-db-security-contract.ts && tsx scripts/test-project-guard.ts && tsx scripts/test-workspace-identity.ts && tsx scripts/test-workspace-availability.ts && npm run test:proof",
    "test:identity": "tsx scripts/test-workspace-identity.ts",
    "test:availability": "tsx scripts/test-workspace-availability.ts",
    "test:wave1": "tsx scripts/test-wave1-contract.ts",
    "test:navigation": "tsx scripts/test-workspace-navigation.ts",
    "test:db-security": "tsx scripts/test-db-security-contract.ts",
    "test:project-guard": "tsx scripts/test-project-guard.ts",
    "test:wave1-acceptance": "tsx scripts/test-wave1-acceptance.ts",
    "seed:da01": "tsx scripts/seed-da01.ts",
    "capture:wave1": "tsx scripts/capture-wave1-visual.ts",
    "test:states": "tsx scripts/test-state-machines.ts",
    "test:disclosure": "tsx scripts/test-disclosure-boundary.ts",
    "test:auth": "tsx scripts/test-safe-next.ts",
    "test:auth-flows": "tsx scripts/test-auth-flows.ts",
    "test:sims": "tsx --conditions react-server scripts/test-micro-scoring.ts",
    "test:v2": "tsx --conditions react-server scripts/test-v2-scoring.ts",
    "test:v3": "tsx scripts/test-northline-v3.ts",
    "test:october": "tsx --conditions react-server scripts/test-october-pilot.ts",
    "test:copy": "tsx scripts/scan-retired-terms.ts",
    "test:a11y": "tsx scripts/audit-accessibility.ts",
    "test:responsive": "tsx scripts/audit-responsive.ts",
    "capture:screens": "tsx scripts/capture-screenshots.ts",
    "capture:employer": "tsx scripts/capture-employer.ts",
    "capture:candidate": "tsx scripts/capture-candidate.ts",
    "capture:gate": "tsx scripts/capture-gate.ts",
    "check:candidate-filter": "tsx scripts/check-candidate-filter.ts",
    "measure:baseline": "tsx scripts/measure-baseline.ts",
    "test:release": "npm run test:sims && npm run test:v2 && npm run test:v3 && npm run test:states && npm run test:disclosure && npm run test:october && npm run test:auth && npm run test:copy && npm run test:db-security && npm run test:project-guard && npm run test:identity && npm run test:availability && npm run typecheck",
    "test:rls-smoke": "tsx scripts/test-rls-smoke.ts",
    "test:sim-engine": "tsx scripts/test-sim-engine-runtime.ts && tsx scripts/test-sim-engine-analysis.ts && tsx scripts/test-golden-path-skeleton.ts && npm run test:golden-path-persistence",
    "test:golden-path-skeleton": "tsx scripts/test-golden-path-skeleton.ts",
    "test:pilot-golden-path": "tsx scripts/test-pilot-golden-path.ts",
    "test:e2e": "playwright test",
    "verify:migrations": "tsx scripts/verify-migration-state.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-platform-admin.ts",
    "admin:password": "tsx scripts/set-admin-password.ts --write",
    "verify:prod": "tsx scripts/verify-production-readiness.ts",
    "seed:dev": "ALLOW_DEV_SEED=true tsx scripts/seed-development.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "alasql": "^4.17.3",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.24",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
